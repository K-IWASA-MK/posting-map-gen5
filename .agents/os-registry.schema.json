{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostingMapAIEmployeeOSRegistrySchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "activationState",
    "principleContract",
    "universalContract",
    "physicalRoles",
    "authorities",
    "rolePackAssignments",
    "capabilityPacks",
    "taskContracts",
    "virtualProfessions",
    "operationalKnowledgeSurfaces"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "activationState": {
      "type": "string",
      "enum": ["staging", "active"]
    },
    "principleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalSource",
        "expectedVersion",
        "sha256"
      ],
      "properties": {
        "canonicalSource": { "type": "string" },
        "expectedVersion": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(\\.\\d{2})?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "universalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneDistrictOneApp",
        "zeroDistrictHardcodingInUniversal",
        "universalEnginePath",
        "districtDataPath"
      ],
      "properties": {
        "oneDistrictOneApp": { "type": "boolean" },
        "zeroDistrictHardcodingInUniversal": { "type": "boolean" },
        "universalEnginePath": { "type": "string" },
        "districtDataPath": { "type": "string" }
      }
    },
    "physicalRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["architect", "execution", "worker", "auditor", "deployer"]
      },
      "uniqueItems": true,
      "minItems": 5,
      "maxItems": 5
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeDeployment", "districtProvisioning"],
      "properties": {
        "codeDeployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizedRole", "requiresMasterExplicitApproval"],
          "properties": {
            "authorizedRole": { "type": "string", "enum": ["execution"] },
            "requiresMasterExplicitApproval": { "type": "boolean" }
          }
        },
        "districtProvisioning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizedRole", "canDeployCode", "requiresMasterExplicitApproval"],
          "properties": {
            "authorizedRole": { "type": "string", "enum": ["deployer"] },
            "canDeployCode": { "type": "boolean", "const": false },
            "requiresMasterExplicitApproval": { "type": "boolean" }
          }
        }
      }
    },
    "rolePackAssignments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architect", "execution", "worker", "auditor", "deployer"],
      "properties": {
        "architect": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "execution": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "worker": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "auditor": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "deployer": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "capabilityPacks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifestPath", "description", "canonicalSources", "evidenceSources"],
        "properties": {
          "manifestPath": { "type": "string" },
          "description": { "type": "string" },
          "canonicalSources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "evidenceSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "taskContracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "requiredPacks", "maxFiles", "stopCondition"],
        "properties": {
          "name": { "type": "string" },
          "requiredPacks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "maxFiles": { "type": "integer", "minimum": 0 },
          "stopCondition": { "type": "string" }
        }
      }
    },
    "virtualProfessions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseRole", "capabilityPacks", "defaultTaskContract"],
        "properties": {
          "baseRole": {
            "type": "string",
            "enum": ["architect", "execution", "worker", "auditor", "deployer"]
          },
          "capabilityPacks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "defaultTaskContract": { "type": "string" }
        }
      }
    },
    "operationalKnowledgeSurfaces": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
