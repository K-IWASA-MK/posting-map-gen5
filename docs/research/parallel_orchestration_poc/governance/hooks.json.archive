{
  "parallel-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|invoke_subagent|define_subagent|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ./scripts/parallel_guard.mjs ]; then node ./scripts/parallel_guard.mjs; else node ../scripts/parallel_guard.mjs; fi"
          }
        ]
      }
    ]
  }
}
